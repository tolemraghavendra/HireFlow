# Set to "true" to force deterministic Demo Mode (no external API calls).
# If left "false" and no valid API key is found, HireFlow automatically falls back to Demo Mode.
DEMO_MODE=false

# OpenAI settings (used when DEMO_MODE=false and a key is present)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite database file (relative to backend/ working directory)
DATABASE_URL=sqlite:///./hireflow.db
